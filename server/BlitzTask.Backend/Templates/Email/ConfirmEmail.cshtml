@model BlitzTask.Backend.Features.Auth.ConfirmEmailModel
@{
    Layout = "_Layout";
}

<h1>Confirm your email address</h1>

<p>Hi @Model.UserName,</p>

<p>
    Thanks for creating an account. Confirm your email address to finish setting it up —
    until you do, most of the app stays locked.
</p>

<div class="button-row">
    <a href="@Model.ConfirmationLink" class="button">Confirm email</a>
</div>

<p class="muted">Or paste this into your browser if the button doesn't work:</p>
<div class="code-block">@Model.ConfirmationLink</div>

<p class="muted">
    The link expires in 24 hours. If you didn't create this account, you can ignore this email.
</p>
