@model BlitzTask.Backend.Features.ProjectMembers.ProjectInvitationModel
@{
    Layout = "_Layout";
}

<h1>You've been invited to a project</h1>

<p>
    <strong>@Model.InviterName</strong> invited you to join
    <strong>@Model.ProjectName</strong> as <span class="badge">@Model.Role</span>
</p>

<div class="button-row">
    <a href="@Model.InvitationLink" class="button">Accept invitation</a>
</div>

<p class="muted">Or paste this into your browser if the button doesn't work:</p>
<div class="code-block">@Model.InvitationLink</div>

<p class="muted">If you weren't expecting this, you can safely ignore this email.</p>
