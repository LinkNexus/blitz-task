@model BlitzTask.Backend.Features.ProjectTasks.TaskReminderEmailModel
@{
    Layout = "_Layout";
}

<h1>Reminder</h1>

<p>Hi @Model.UserName,</p>

<p>
    <strong>@Model.TaskName</strong> in <strong>@Model.ProjectName</strong>
    is due @Model.DueDateText.
</p>

<div class="button-row">
    <a href="@Model.TaskLink" class="button">Open the project</a>
</div>

<p class="muted">
    You are getting this because you set a reminder on this task. Removing the reminder, or
    completing the task, stops it.
</p>
