@model BlitzTask.Backend.Features.Auth.PasswordResetModel
@{
    Layout = "_Layout";
}

<h1>Reset your password</h1>

<p>Hi @Model.UserName,</p>

<p>We got a request to reset your password. Choose a new one here:</p>

<div class="button-row">
    <a href="@Model.ResetLink" class="button">Reset password</a>
</div>

<p class="muted">Or paste this into your browser if the button doesn't work:</p>
<div class="code-block">@Model.ResetLink</div>

<p class="muted">
    The link expires in 24 hours. If you didn't ask for this, you can ignore this email —
    your password stays as it is.
</p>
